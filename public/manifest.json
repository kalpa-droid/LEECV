{
  "short_name": "LEECV",
  "name": "LEECV — Creador de Currículum Vitae listo para imprimir",
  "description": "Crea tu Currículum Vitae listo para imprimir, con plantillas profesionales y compatibilidad ATS.",
  "icons": [
    {
      "src": "/brand/favicon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/brand/pwa-192x192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/brand/pwa-512x512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    }
  ],
  "start_url": "/",
  "background_color": "#ffffff",
  "theme_color": "#FFFFFF",
  "display": "standalone",
  "orientation": "portrait",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "file_handlers": [
    {
      "action": "/crear-cv",
      "accept": {
        "application/vnd.leecv.document+json": [".leecv"]
      },
      "icons": [
        { "src": "/brand/pwa-192x192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/brand/pwa-512x512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/crear-editor",
      "accept": {
        "application/vnd.leecv.editorial+zip": [".leedoc", ".leecv-editor"]
      },
      "icons": [
        { "src": "/brand/pwa-192x192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/brand/pwa-512x512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/crear-tarjeta",
      "accept": {
        "application/vnd.leecv.card+json": [".leecard"]
      },
      "icons": [
        { "src": "/brand/pwa-192x192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/brand/pwa-512x512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/crear-libro",
      "accept": {
        "application/vnd.leecv.book+zip": [".leebook"]
      },
      "icons": [
        { "src": "/brand/pwa-192x192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/brand/pwa-512x512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "/crear-agenda",
      "accept": {
        "application/vnd.leecv.planner+json": [".leeplan"]
      },
      "icons": [
        { "src": "/brand/pwa-192x192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/brand/pwa-512x512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "launch_type": "single-client"
    }
  ]
}
