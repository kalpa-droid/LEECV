+/** Suma el tamaño real de los archivos que la organización tiene en el bucket */
+export async function getLEECVCloudUsage(orgId) {
+  if (!supabase || !orgId) {
+    return { usedGB: 0, totalGB: 50, percentUsed: 0 };
+  }
+
+  try {
+    const { data: files, error } = await supabase.storage
+      .from('certificates')
+      .list(orgId, { limit: 1000 });
+    if (error) throw error;
+
+    const totalBytes = (files || []).reduce((sum, f) => sum + (f.metadata?.size || 0), 0);
+    const usedGB = totalBytes / (1024 ** 3);
+    const totalGB = 50; // cupo fijo del plan Enterprise
+    const percentUsed = Math.round((usedGB / totalGB) * 100);
+
+    return { usedGB: Number(usedGB.toFixed(2)), totalGB, percentUsed };
+  } catch (err) {
+    console.warn('No se pudo calcular el uso de LEECV Cloud:', err);
+    return { usedGB: 0, totalGB: 50, percentUsed: 0, error: err.message };
+  }
 }
