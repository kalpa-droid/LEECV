# ============================================================
# LEECV — Variables de Entorno de Producción & Desarrollo
# Copia este archivo a .env.local para tu entorno local
# e inserta estos valores en Vercel -> Settings -> Environment Variables
# ============================================================

# 1. Supabase Database & Auth (Cliente & Servidor)
VITE_SUPABASE_URL=https://sxcbarjsbpiucrdqfxty.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima-publica
SUPABASE_URL=https://sxcbarjsbpiucrdqfxty.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey... (service_role key con permisos administrativos de servidor)

# 2. Configuración de Sitio & Dominio Base
SITE_URL=https://leecv.vercel.app

# 3. Mercado Pago (Pasarela Principal Argentina / Latam)
MP_ACCESS_TOKEN=tu-mp-access-token-produccion
MP_WEBHOOK_SECRET=tu-clave-secreta-webhook-mercadopago
MP_PRECIO_PDF_ARS=1900
MP_PRECIO_PACK5_ARS=7500
MP_PRECIO_PACK10_ARS=12500
MP_PRECIO_PRO_ARS=18500
MP_PRECIO_ENTERPRISE_ARS=28500
# Opcionales — si no se cargan, el backend usa los mismos valores que ya
# están en api/_lib/paymentProviders/pricingCatalog.ts (fuente única de
# verdad, sincronizada con este mismo catálogo del lado del frontend por
# npm run verify:pricing-sync).
PAYPAL_PRECIO_PDF_USD=2.00
PAYPAL_PRECIO_PACK5_USD=8.00
PAYPAL_PRECIO_PACK10_USD=14.00
PAYPAL_PRECIO_PRO_USD=19.00
PAYPAL_PRECIO_ENTERPRISE_USD=29.00

# 4. PayPal (Pasarela Internacional)
PAYPAL_CLIENT_ID=tu-paypal-client-id
PAYPAL_CLIENT_SECRET=tu-paypal-client-secret
PAYPAL_ENV=live
PAYPAL_WEBHOOK_ID=tu-paypal-webhook-id

# 5. Lemon Squeezy (Pasarela Suscripciones Internacionales)
LEMONSQUEEZY_API_KEY=tu-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=tu-lemonsqueezy-webhook-secret
# Opcionales — IDs numéricos de variante para mapeo exacto de webhooks
LS_VARIANT_SINGLE_PDF=111111
LS_VARIANT_PACK5=222222
LS_VARIANT_PACK10=333333
LS_VARIANT_PRO=444444
LS_VARIANT_ENTERPRISE=555555

# 6. Google Drive OAuth (Respaldo en la Nube del Usuario)
GOOGLE_CLIENT_ID=355661929589-placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret-placeholder

# 7. Vercel Cron (Protección del endpoint de downgrade automático)
CRON_SECRET=generar-un-string-random-largo-y-guardarlo-tambien-en-vercel

# 8. Lemon Squeezy — URLs de checkout opcionales (el código ya tiene fallbacks para Pro, Enterprise y PDF1)
VITE_LEMONSQUEEZY_URL_PDF1=https://leecv-26.lemonsqueezy.com/checkout/buy/8ddd3fca-c0f8-493f-8f44-05389e74a0e9
VITE_LEMONSQUEEZY_URL_PACK5=https://leecv-26.lemonsqueezy.com/checkout/buy/tu-variante-pack5
VITE_LEMONSQUEEZY_URL_PACK10=https://leecv-26.lemonsqueezy.com/checkout/buy/tu-variante-pack10
VITE_LEMONSQUEEZY_URL_PRO=https://leecv-26.lemonsqueezy.com/checkout/buy/6b4b732a-d1ec-48de-89f0-02a3d02be613
VITE_LEMONSQUEEZY_URL_ENTERPRISE=https://leecv-26.lemonsqueezy.com/checkout/buy/d8968d41-e826-43a8-a057-bf51e8add5e3

