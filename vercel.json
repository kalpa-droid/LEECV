{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-downgrade",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/mercadopago-webhook",
      "destination": "/api/webhooks?provider=mercadopago"
    },
    {
      "source": "/api/paypal-webhook",
      "destination": "/api/webhooks?provider=paypal"
    },
    {
      "source": "/api/lemonsqueezy-webhook",
      "destination": "/api/webhooks?provider=lemonsqueezy"
    },
    {
      "source": "/api/create-paypal-order",
      "destination": "/api/paypal-order?action=create"
    },
    {
      "source": "/api/capture-paypal-order",
      "destination": "/api/paypal-order?action=capture"
    },
    {
      "source": "/api/admin/integrations-status",
      "destination": "/api/admin-api?action=integrations-status"
    },
    {
      "source": "/api/admin/list-processed-payments",
      "destination": "/api/admin-api?action=list-processed-payments"
    },
    {
      "source": "/api/approve-manual-claim",
      "destination": "/api/admin-api?action=approve-manual-claim"
    },
    {
      "source": "/api/drive/connect",
      "destination": "/api/drive-api?action=connect"
    },
    {
      "source": "/api/drive/disconnect",
      "destination": "/api/drive-api?action=disconnect"
    },
    {
      "source": "/api/drive/get-access-token",
      "destination": "/api/drive-api?action=get-access-token"
    },
    {
      "source": "/api/cron/downgrade-expired-plans",
      "destination": "/api/cron-downgrade"
    },
    {
      "source": "/(c|cv|public)/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|LinkedInBot|Twitterbot|Slackbot|TelegramBot|Discordbot).*"
        }
      ],
      "destination": "/api/cv-meta?slug=:slug"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
